# Model Configuration
# Format: "provider/model-id" (e.g., "deepseek/deepseek-v4-flash")
AGENT_MODEL=deepseek/deepseek-v4-flash

# Custom Provider Configuration (optional)
# Only needed when using a non-built-in provider (e.g., mimo, ollama)
#
# AGENT_PROVIDER_ID=mimo
# AGENT_PROVIDER_BASE_URL=https://api.mimo.example.com/v1
# AGENT_PROVIDER_API=openai-completions  # or "anthropic-messages"
# AGENT_API_KEY=sk-your-api-key-here
#
# Model-specific configuration (optional):
# AGENT_MODEL_MAX_TOKENS=8192          # Max output tokens
# AGENT_MODEL_CONTEXT_WINDOW=1000000   # Context window size (1M)
# AGENT_MODEL_REASONING=false          # Enable reasoning/thinking (true/false)

# Built-in providers (no extra config needed, just set the API key):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# etc.
