{
  "name": "up-reviewer",
  "version": "0.2.0",
  "description": "Flue agent that reviews git diffs and reports structured, line-anchored findings",
  "files": [
    "dist/",
    "templates/",
    "flue.config.ts"
  ],
  "bin": {
    "review-diff": "dist/workflow/review.js"
  },
  "exports": {
    ".": {
      "types": "./dist/agents/reviewer.d.ts",
      "import": "./dist/agents/reviewer.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/agents/reviewer.js",
  "types": "./dist/agents/reviewer.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:types": "tsc --noEmit",
    "review": "node --env-file-if-exists=.env src/workflow/review.ts",
    "test": "node --test \"src/lib/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senbinil/up-reviewer.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/senbinil/up-reviewer/issues"
  },
  "homepage": "https://github.com/senbinil/up-reviewer#readme",
  "dependencies": {
    "@flue/runtime": "^2.0.3",
    "gray-matter": "^4.0.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.3",
    "typescript": "^5.9.0"
  }
}
