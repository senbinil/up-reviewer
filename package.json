{
  "name": "up-github-agents",
  "version": "1.0.0",
  "description": "Flue agent that reviews git diffs and reports structured, line-anchored findings",
  "files": [
    "src/",
    "templates/",
    "flue.config.ts"
  ],
  "bin": {
    "review-diff": "./src/workflow/review.ts"
  },
  "exports": {
    ".": "./src/agents/reviewer.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "check:types": "tsc --noEmit",
    "review": "node --env-file-if-exists=.env src/workflow/review.ts",
    "test": "node --test \"src/lib/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binilsn/up-github-agents.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/binilsn/up-github-agents/issues"
  },
  "homepage": "https://github.com/binilsn/up-github-agents#readme",
  "dependencies": {
    "@flue/runtime": "^2.0.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.3",
    "typescript": "^5.9.0"
  }
}
